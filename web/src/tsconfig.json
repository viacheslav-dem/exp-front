{
  "compilerOptions": {
    "declaration": false,
    "experimentalDecorators": true,
    "lib": [
      "es6",
      "dom"
    ],
    "mapRoot": "./",
    "module": "es2020",
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "app/*"
      ]
    },
    "moduleResolution": "node",
    "outDir": "../dist/out-tsc",
    "sourceMap": true,
    "target": "ES2020",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "angularCompilerOptions": {
    "strictInjectionParameters":true,
    "trace":true
  },
  "exclude": [
    "../node_modules"
  ],
  "types": []
}
